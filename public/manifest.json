{
  "manifest_version": 3,
  "name": "Friction",
  "version": "0.0.22",
  "action": {
    "default_popup": "index.html"
  },
  "description": "A plain-text description",
  "permissions": ["storage", "tabs"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["friction-content.js"],
      "run_at": "document_idle"
    }
  ]
}